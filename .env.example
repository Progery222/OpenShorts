# =============================================================================
# OpenShorts — переменные окружения (сервер / Docker backend)
# Скопируйте в .env и заполните значения. Файл .env не коммитьте.
# =============================================================================

# --- Очередь обработки ---
MAX_CONCURRENT_JOBS=5

# --- Google Gemini (опционально на сервере) ---
# Обычно ключ вводится в UI (Settings). Если задать здесь — сработает fallback в API.
GEMINI_API_KEY=

# --- OpenAI (fallback, если Gemini недоступен / ошибка / плохой JSON) ---
# Нужен для переключения в main.py при сбое Gemini. Не решает общий обрыв DNS в контейнере.
OPENAI_API_KEY=
# Например: gpt-4o-mini, gpt-4o
OPENAI_CLIP_MODEL=gpt-4o-mini

# --- AWS S3 (опционально — бэкап клипов / публичная галерея) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BUCKET=

# --- YouTube / yt-dlp (Docker) ---
# Сырые Netscape-cookies одной строкой (см. комментарии в .env у проекта).
# YOUTUBE_COOKIES=
# Не использовать cookies.txt / env: 1, true, yes
YOUTUBE_DISABLE_COOKIES=

# --- Внутренняя сеть Docker ---
# Оставьте по умолчанию, если renderer в compose называется renderer и слушает 3100.
RENDER_SERVICE_URL=http://renderer:3100

# =============================================================================
# Frontend (Vite) — задаются при сборке, не в корневом .env для dev в Docker
# Положите в dashboard/.env при необходимости:
# VITE_API_URL=
# VITE_ENCRYPTION_KEY=
# =============================================================================
